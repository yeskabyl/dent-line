# Скопируйте в .env.local и заполните. Пустые значения скрывают соответствующие элементы сайта.

# Домен сайта (для canonical, sitemap, Open Graph). Без слэша в конце.
NEXT_PUBLIC_SITE_URL=https://example.kz

# Полный номер клиники, например +7 701 000 00 00
CLINIC_PHONE=

# Официальный номер WhatsApp клиники (цифры), например 77010000000
CLINIC_WHATSAPP=

# Официальные ссылки
CLINIC_INSTAGRAM_URL=
CLINIC_2GIS_URL=

# Webhook, который принимает заявки (CRM, n8n, Google Apps Script и т.п.).
# Получает JSON: name, phone, service, date, timeWindow, source, consent, createdAt.
# Должен отвечать 2xx только если заявка действительно принята.
BOOKING_WEBHOOK_URL=
